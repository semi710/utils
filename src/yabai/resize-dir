#!/usr/bin/env bash
set -euo pipefail

dir="$1"
delta=20

# Snapshot frame to detect if a resize actually took effect
# (yabai returns 0 even when the app rejects the resize)
before=$(yabai -m query --windows --window | jq -r '"\(.frame.w) \(.frame.h)"')
w=${before% *}
h=${before#* }

# Proportional deltas to preserve aspect ratio
hd=$((delta * h / w))
wd=$((delta * w / h))

# Try a resize; succeed only if the window actually changed
try() {
  yabai -m window --resize "$1" 2>/dev/null || true
  after=$(yabai -m query --windows --window | jq -r '"\(.frame.w) \(.frame.h)"')
  [ "$before" != "$after" ]
}

case "$dir" in
  h) try "right:-${delta}:0" || try "left:${delta}:0" || try "bottom_right:-${delta}:-${hd}" ;;
  l) try "right:${delta}:0" || try "left:-${delta}:0" || try "bottom_right:${delta}:${hd}" ;;
  k) try "bottom:0:-${delta}" || try "top:0:${delta}" || try "bottom_right:-${wd}:-${delta}" ;;
  j) try "bottom:0:${delta}" || try "top:0:-${delta}" || try "bottom_right:${wd}:${delta}" ;;
  *) echo "usage: $0 h|j|k|l" >&2; exit 1 ;;
esac
