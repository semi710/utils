#!/usr/bin/env bash
set -euo pipefail

dir="$1"
delta=20

window=$(yabai -m query --windows --window)
is_floating=$(echo "$window" | jq -r '.["is-floating"]')

if [ "$is_floating" = "true" ]; then
  # Try single-edge first (works for normal floating windows).
  # If the non-target dimension also changed, the app enforces aspect ratio.
  # Undo and use proportional diagonal instead (preserves ratio).
  read -r ow oh <<< "$(echo "$window" | jq -r '.frame | "\(.w|floor) \(.h|floor)"')"

  case "$dir" in
    h) yabai -m window --resize "right:-${delta}:0" 2>/dev/null || true ;;
    l) yabai -m window --resize "right:${delta}:0" 2>/dev/null || true ;;
    k) yabai -m window --resize "bottom:0:-${delta}" 2>/dev/null || true ;;
    j) yabai -m window --resize "bottom:0:${delta}" 2>/dev/null || true ;;
    *) echo "usage: $0 h|j|k|l" >&2; exit 1 ;;
  esac

  read -r _ _ nw nh <<< "$(yabai -m query --windows --window | jq -r '.frame | "\(.x|floor) \(.y|floor) \(.w|floor) \(.h|floor)"')"

  # If single-edge changed anything, keep it - the app handled aspect ratio
  # adjustment itself (both dims changed proportionally). Only fall back to
  # proportional diagonal when single-edge was fully rejected (no change).
  if [ "$ow" = "$nw" ] && [ "$oh" = "$nh" ]; then
    hd=$(echo "$window" | jq -r --argjson d "$delta" '($d * .frame.h / .frame.w) | floor')
    wd=$(echo "$window" | jq -r --argjson d "$delta" '($d * .frame.w / .frame.h) | floor')
    case "$dir" in
      h) yabai -m window --resize "bottom_right:-${delta}:-${hd}" 2>/dev/null ;;
      l) yabai -m window --resize "bottom_right:${delta}:${hd}" 2>/dev/null ;;
      k) yabai -m window --resize "bottom_right:-${wd}:-${delta}" 2>/dev/null ;;
      j) yabai -m window --resize "bottom_right:${wd}:${delta}" 2>/dev/null ;;
    esac
  fi
else
  case "$dir" in
    h) yabai -m window --resize "right:-${delta}:0" 2>/dev/null || yabai -m window --resize "left:${delta}:0" 2>/dev/null ;;
    l) yabai -m window --resize "right:${delta}:0" 2>/dev/null || yabai -m window --resize "left:-${delta}:0" 2>/dev/null ;;
    k) yabai -m window --resize "bottom:0:-${delta}" 2>/dev/null || yabai -m window --resize "top:0:${delta}" 2>/dev/null ;;
    j) yabai -m window --resize "bottom:0:${delta}" 2>/dev/null || yabai -m window --resize "top:0:-${delta}" 2>/dev/null ;;
    *) echo "usage: $0 h|j|k|l" >&2; exit 1 ;;
  esac
fi
