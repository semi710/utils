#!/usr/bin/env bash
set -euo pipefail

process=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --process) process="$2"; shift 2 ;;
    *) break ;;
  esac
done

app="$1"
pgrep_name="${process:-$app}"
front_app=$(osascript -e 'tell application "System Events" to name of first application process whose frontmost is true')

if [[ "$front_app" == "$app" || "$front_app" == "$pgrep_name" ]]; then
  osascript -e "tell application \"$app\" to hide"
else
  if pgrep -f "$pgrep_name" >/dev/null 2>&1; then
    osascript -e "tell application \"$app\" to activate"
  else
    open -a "$app" 2>/dev/null || command "$app" & disown
  fi
fi
