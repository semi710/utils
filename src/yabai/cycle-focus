#!/usr/bin/env bash
set -euo pipefail

dir="${1:-}"
case "$dir" in
  next) dir="east" ;;
  prev) dir="west" ;;
esac

layout=$(yabai -m query --spaces --space | jq -r '.type')

if [ "$layout" = "stack" ]; then
  case "$dir" in
    east|south) yabai -m window --focus stack_next 2>/dev/null || yabai -m window --focus stack_first 2>/dev/null ;;
    west|north) yabai -m window --focus stack_prev 2>/dev/null || yabai -m window --focus stack_last 2>/dev/null ;;
  esac
  exit 0
fi

yabai -m window --focus "$dir" 2>/dev/null || {
  case "$dir" in
    east|west) yabai -m display --focus "$dir" 2>/dev/null ;;
  esac
}
