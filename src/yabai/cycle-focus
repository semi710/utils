#!/usr/bin/env bash
set -euo pipefail

dir="${1:-}"
case "$dir" in
  next) dir="east" ;;
  prev) dir="west" ;;
esac

cur_json=$(yabai -m query --windows --window)
is_floating=$(echo "$cur_json" | jq -r '."is-floating"')

if [ "$is_floating" = "true" ]; then
  # Spatial focus for floating windows
  cur_id=$(echo "$cur_json" | jq -r '.id')
  target=$(yabai -m query --windows --space | jq -r --argjson cur "$cur_json" --argjson cid "$cur_id" --arg dir "$dir" '
    def dist(a;b): (a - b) * (a - b);
    [.[] | select(.id != $cid and .visible == 1)]
    | map(select(
        ($dir == "west"  and .frame.x + .frame.w <= $cur.frame.x) or
        ($dir == "east"  and .frame.x >= $cur.frame.x + $cur.frame.w) or
        ($dir == "north" and .frame.y + .frame.h <= $cur.frame.y) or
        ($dir == "south" and .frame.y >= $cur.frame.y + $cur.frame.h)
      ))
    | sort_by(
        if $dir == "west" or $dir == "east" then
          dist($cur.frame.x + $cur.frame.w/2; .frame.x + .frame.w/2) * 4 +
          dist($cur.frame.y + $cur.frame.h/2; .frame.y + .frame.h/2)
        else
          dist($cur.frame.x + $cur.frame.w/2; .frame.x + .frame.w/2) +
          dist($cur.frame.y + $cur.frame.h/2; .frame.y + .frame.h/2) * 4
        end
      )
    | first?.id // empty
  ')
  [ -n "$target" ] && yabai -m window --focus "$target"
else
  # Built-in directional focus for tiled windows
  if yabai -m window --focus "$dir" 2>/dev/null; then
    exit 0
  fi
  # Fallback: display focus for east/west
  case "$dir" in
    east|west) yabai -m display --focus "$dir" ;;
  esac
fi
