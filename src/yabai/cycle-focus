#!/usr/bin/env bash
set -euo pipefail

dir="${1:-}"
case "$dir" in
  next) dir="east" ;;
  prev) dir="west" ;;
esac

layout=$(yabai -m query --spaces --space | jq -r '.type')

if [ "$layout" = "stack" ]; then
  case "$dir" in
    east|south) yabai -m window --focus stack.next 2>/dev/null || yabai -m window --focus stack.first 2>/dev/null ;;
    west|north) yabai -m window --focus stack.prev 2>/dev/null || yabai -m window --focus stack.last 2>/dev/null ;;
  esac
  exit 0
fi

# BSP: try native directional focus first (fast path for tiled->tiled)
yabai -m window --focus "$dir" 2>/dev/null && exit 0

# Fallback: coordinate-based focus for floating windows.
# Native --focus only traverses the BSP tree, so it fails when the
# focused window is floating or when the target is floating.
cur=$(yabai -m query --windows --window)
cid=$(echo "$cur" | jq -r '.id')
cx=$(echo "$cur" | jq '.frame.x + .frame.w/2')
cy=$(echo "$cur" | jq '.frame.y + .frame.h/2')

target=$(yabai -m query --windows --space | jq -r \
  --argjson cid "$cid" --argjson cx "$cx" --argjson cy "$cy" --arg dir "$dir" '
  [.[] | select(.id != $cid and .["is-visible"] == true)
    | (.frame.x + .frame.w/2 - $cx) as $dx
    | (.frame.y + .frame.h/2 - $cy) as $dy
    | select(
        ($dir == "west"  and $dx < 0 and $dx*$dx > $dy*$dy) or
        ($dir == "east"  and $dx > 0 and $dx*$dx > $dy*$dy) or
        ($dir == "north" and $dy < 0 and $dy*$dy > $dx*$dx) or
        ($dir == "south" and $dy > 0 and $dy*$dy > $dx*$dx)
      )
    | {id, dist: $dx*$dx + $dy*$dy}
  ]
  | sort_by(.dist) | .[0].id // empty')

if [ -n "$target" ]; then
  yabai -m window --focus "$target"
else
  case "$dir" in
    east|west) yabai -m display --focus "$dir" 2>/dev/null ;;
  esac
fi
