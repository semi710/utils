#!/usr/bin/env bash
set -euo pipefail

dir="${1:-}"
case "$dir" in
  next) dir="east" ;;
  prev) dir="west" ;;
esac

# Get current window position
cur_json=$(yabai -m query --windows --window)
cur_id=$(echo "$cur_json" | jq -r '.id')
cx=$(echo "$cur_json" | jq '.frame.x + .frame.w / 2')
cy=$(echo "$cur_json" | jq '.frame.y + .frame.h / 2')

# Find closest visible window in the requested direction
# Uses actual screen coordinates — works for tiled AND floating windows
target=$(yabai -m query --windows --space | jq -r \
  --argjson cid "$cur_id" \
  --argjson cx "$cx" \
  --argjson cy "$cy" \
  --arg dir "$dir" \
  '[.[] | select(.id != $cid and .["is-visible"] == true)]
   | map(select(
       ($dir == "west"  and .frame.x + .frame.w/2 < $cx) or
       ($dir == "east"  and .frame.x + .frame.w/2 > $cx) or
       ($dir == "north" and .frame.y + .frame.h/2 < $cy) or
       ($dir == "south" and .frame.y + .frame.h/2 > $cy)
     ))
   | sort_by(
       if $dir == "west" or $dir == "east" then
         (($cx - (.frame.x + .frame.w/2)) * ($cx - (.frame.x + .frame.w/2))) * 4 +
         (($cy - (.frame.y + .frame.h/2)) * ($cy - (.frame.y + .frame.h/2)))
       else
         (($cx - (.frame.x + .frame.w/2)) * ($cx - (.frame.x + .frame.w/2))) +
         (($cy - (.frame.y + .frame.h/2)) * ($cy - (.frame.y + .frame.h/2))) * 4
       end
     )
   | .[0].id // empty')

if [ -n "$target" ]; then
  yabai -m window --focus "$target"
else
  # Nothing in that direction on this space — try next display
  case "$dir" in
    east|west) yabai -m display --focus "$dir" ;;
  esac
fi
